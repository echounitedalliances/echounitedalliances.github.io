# Keys for the local tools that run on the owner's machine (the weekly
# scrape's uploads, and whatever comes later). Copy to .env, which git
# ignores, and fill it in there. Never put a value in this file, and never
# give one a VITE_ prefix or put one under web/: those end up in the
# public site.

# Supabase Storage, S3 protocol: Project Settings -> Storage -> S3 access keys.
# Used by the weekly build to upload the departure boards and timetables.
# The endpoint and region are the project's own and are not secret.
SUPABASE_S3_ENDPOINT=https://ehthjudmsptplumafglo.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
