# Supabase project settings -> API. Both are safe in a public build: the
# publishable key is designed to be shipped to browsers, and every table is
# protected by the row level security in database/sql/08_rls_policies.sql.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The board's Discord webhook (channel settings -> Integrations -> Webhooks).
#
# NOT used by the site, and deliberately not VITE_-prefixed, so it never
# reaches the public bundle. The database sends the notice
# (database/sql/41_admin_apply_notice.sql); this line is only where
# database/scripts/set_admin_webhook.ps1 reads the URL from to store it in
# Supabase Vault. Re-run that script after regenerating the webhook.
ADMIN_APPLY_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
