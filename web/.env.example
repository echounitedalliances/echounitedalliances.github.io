# Supabase project settings -> API. Both are safe in a public build: the
# publishable key is designed to be shipped to browsers, and every table is
# protected by the row level security in database/sql/08_rls_policies.sql.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The board's Discord webhook (channel settings -> Integrations -> Webhooks).
#
# Optional, and only the notification half: an application is recorded in the
# database either way and shows up in the admin queue on the Resonance page.
# Without this, applying still works -- the board simply has to look at the
# queue rather than being pinged about it.
#
# Unlike the Supabase values above, this one is NOT designed to be public: it
# ends up in the built bundle as-is, and anyone who reads it out of devtools
# can post to the channel directly. If that ever happens, regenerate the
# webhook in Discord and rebuild.
VITE_ADMIN_APPLY_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
